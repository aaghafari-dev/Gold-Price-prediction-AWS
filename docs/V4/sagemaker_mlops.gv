digraph G {
rankdir=TB;graph [bgcolor="#0B1220", pad="0.25", nodesep="0.28", ranksep="0.42", splines=ortho, fontname="Segoe UI", labeljust="c", labelloc="t"];
node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#49617F", fontcolor="#F5F7FB", margin="0.16,0.10", penwidth=1.2];
edge [color="#7C9BC5", penwidth=1.4, arrowsize=0.75, fontname="Segoe UI", fontsize=9, fontcolor="#C9D7EA"];

sso [label="Developer / GUI authenticates through AWS CLI SSO or IAM role\nNo AWS username/password stored in GUI",fillcolor="#334155"];
s3 [label="Amazon S3 data and artifacts\nRaw / curated / evaluation / model artifacts; encryption + versioning",fillcolor="#14532D"];
pipeline [label="SageMaker Pipelines definition\nProcessingStep → TrainingStep → EvaluationStep → ConditionStep",fillcolor="#5B21B6"];
proc [label="SageMaker Processing Job\nSchema normalization, feature engineering, split, leakage audit\nNo model training in Processing step",fillcolor="#1D4ED8"];
train [label="SageMaker Training Job(s)\nARIMA and ML candidate algorithms in container/script\nCV + bounded tuning; managed compute instance",fillcolor="#6D28D9"];
exp [label="SageMaker Experiments\nRun/experiment tracking: parameters, metrics, artifact URI, data/code version",fillcolor="#5B21B6"];
condition [label="Condition / quality gate\nRMSE improvement, MAE/RMSE valid, leakage PASS, coverage threshold\nFail path logs metrics but blocks registration",fillcolor="#92400E"];
registry [label="SageMaker Model Registry\nModel Package Group + immutable versions\nStatus: PendingManualApproval",fillcolor="#14532D"];
approval [label="Manual review in GUI/AWS Console\nReview evaluation report, model card, feature lineage, expected costs",fillcolor="#9F1239"];
endpoint [label="SageMaker Endpoint deployment\nOnly Approved package version can be deployed",fillcolor="#0F766E"];
monitor [label="Model Monitor + CloudWatch\nData quality/drift, latency, 4xx/5xx, CPU/memory where exposed\nPrediction error once ground truth is available",fillcolor="#334155"];
trigger [label="EventBridge schedule / CloudWatch alarm\nTrigger pipeline/retraining candidate; never auto-approve replacement",fillcolor="#7C3AED"];
sso -> pipeline [label="upsert/execute"]; s3 -> proc -> train -> exp; train -> condition; exp -> condition; condition -> registry [label="pass"]; condition -> s3 [label="fail report"]; registry -> approval -> endpoint -> monitor -> trigger -> pipeline;
}