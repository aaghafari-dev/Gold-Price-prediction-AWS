digraph G {
rankdir=TB;graph [bgcolor="#0B1220", pad="0.25", nodesep="0.28", ranksep="0.42", splines=ortho, fontname="Segoe UI", labeljust="c", labelloc="t"];
node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#49617F", fontcolor="#F5F7FB", margin="0.16,0.10", penwidth=1.2];
edge [color="#7C9BC5", penwidth=1.4, arrowsize=0.75, fontname="Segoe UI", fontsize=9, fontcolor="#C9D7EA"];

trigger [label="EventBridge Scheduler (cloud) / GUI button (manual test)\nUser selects market lookback: 1, 2, 3, 5, 10, 15 or 20 years\nNews lookback: 1, 3, 7, 14 or 30 days",fillcolor="#164E63"];
lambda [label="Lambda ingestion function\nOne orchestration function calls separate market and news adapter modules\nTimeout/retry limits • correlation/run ID • structured logs",fillcolor="#155E75"];
market [label="Yahoo Finance market adapter (yfinance.download)\nDaily interval; configured tickers; requested historical period\nOHLCV schema normalized; UTC/date normalized",fillcolor="#1D4ED8"];
news [label="Yahoo Finance ticker-news adapter\nyfinance.Ticker('GC=F').get_news(count=...)\nRecent metadata only: title, summary, publication time, URL/provider\nNo API key; no scraping; history/feed completeness not guaranteed",fillcolor="#1D4ED8"];
normalize [label="Shared normalization + validation\nTyped timestamps; canonical columns; dedupe; missing title/time rejects\nMarket rows: finite close, unique Date, ascending order",fillcolor="#0F766E"];
raw [label="S3 raw zone (cloud) / data/raw (local development)\nmarket_daily.csv • news.csv • news_ingestion_log.csv\nLog one record for every attempt, including zero rows/errors",fillcolor="#14532D"];
quality [label="Ingestion quality report\nRows fetched / rows accepted / duplicates / invalid timestamps\nProvider window + retrieval timestamp + error category",fillcolor="#92400E"];
trigger -> lambda; lambda -> market; lambda -> news; market -> normalize; news -> normalize; normalize -> raw -> quality;
}