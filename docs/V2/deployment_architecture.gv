digraph DeploymentArchitecture {
  graph [label="Deployment View — Developer PC and AWS Account", labelloc=t, fontsize=20, fontname="Arial", rankdir=LR, splines=ortho, nodesep=0.4, ranksep=0.7, pad=0.25, bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#486581", fillcolor="#F0F4F8", margin="0.14,0.09"];
  edge [fontname="Arial", fontsize=9, color="#627D98", arrowsize=0.75];
  subgraph cluster_local { label="Developer workstation (Windows + VS Code)"; color="#9FB3C8"; style="rounded";
    code [label="Git repository\nPython source + tests"];
    localrun [label="Local pipeline\nfetch • features • train • evaluate"];
    localapi [label="FastAPI / Swagger UI"];
    dot [label="Graphviz .gv files\narchitecture diagrams"];
    code -> localrun; code -> localapi;
  }
  subgraph cluster_aws { label="AWS account"; color="#9FB3C8"; style="rounded";
    iam [label="IAM role / least privilege"];
    s3 [label="Amazon S3\nraw / processed / artifacts", fillcolor="#E3F2FD"];
    pipe [label="SageMaker Pipeline"];
    train [label="Processing + Training Jobs"];
    reg [label="Model Registry\nmanual approval", fillcolor="#E8F5E9"];
    ep [label="SageMaker HTTPS endpoint", fillcolor="#EDE7F6"];
    cw [label="CloudWatch logs + metrics"];
    pipe -> train -> reg -> ep; ep -> cw;
  }
  localrun -> s3 [label="upload data / artifacts"];
  localapi -> ep [label="optional client integration"];
  iam -> s3 [style=dashed, label="authorizes"]; iam -> pipe [style=dashed]; iam -> ep [style=dashed];
}