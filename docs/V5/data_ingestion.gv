digraph G {
rankdir=TB; graph [bgcolor="#0B1220", pad="0.25", nodesep="0.28", ranksep="0.42", splines=ortho, fontname="Segoe UI", labeljust="c", labelloc="t", label="V8 | DATA INGESTION — AWS PRODUCTION"];
node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#49617F", fontcolor="#F5F7FB", margin="0.16,0.10", penwidth=1.2];
edge [color="#7C9BC5", penwidth=1.4, arrowsize=0.75, fontname="Segoe UI", fontsize=9, fontcolor="#C9D7EA"];
trigger [label="EventBridge Scheduler (scheduled)\nOR GUI-triggered test via authenticated AWS API\nParameters: market period + news lookback",fillcolor="#164E63"];
collect [label="Lambda A — Collector / orchestrator\nCalls yfinance market adapter + Yahoo ticker-news adapter\nRetries, timeout, run_id, structured status\nNo password/API key for Yahoo ticker news",fillcolor="#155E75"];
market [label="Market adapter\nyfinance.download(tickers, period, interval='1d')\nRaw OHLCV + provider metadata",fillcolor="#1D4ED8"];
news [label="News adapter\nyfinance.Ticker('GC=F').get_news()\ncompatibility fallback: Ticker.news\nRecent article metadata only; zero rows are possible",fillcolor="#1D4ED8"];
raw [label="S3 landing/raw prefix\nImmutable/raw response snapshots where feasible\nrun_id, retrieved_at_utc, request window",fillcolor="#14532D"];
normalizer [label="Lambda B — Schema normalizer (separate function)\nCanonical columns + UTC timestamps + type conversion\nDeduplicate; reject missing title/publication time\nWrite accepted CSV/Parquet + rejected-row report",fillcolor="#0F766E"];
archive [label="S3 normalized/raw archive\nmarket_daily.csv • news.csv • news_ingestion_log.csv\nEvery attempt logged, including zero rows and errors",fillcolor="#14532D"];
processing [label="SageMaker Processing (second, stricter validation)\nData quality contract + stale/missing checks + feature preparation\nLeakage audit and chronological split before training",fillcolor="#1D4ED8"];
trigger -> collect; collect -> market; collect -> news; market -> raw; news -> raw; raw -> normalizer -> archive -> processing;
}