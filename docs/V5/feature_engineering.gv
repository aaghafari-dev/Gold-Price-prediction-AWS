digraph G {
rankdir=TB;graph [bgcolor="#0B1220", pad="0.25", nodesep="0.28", ranksep="0.42", splines=ortho, fontname="Segoe UI", labeljust="c", labelloc="t"];
node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#49617F", fontcolor="#F5F7FB", margin="0.16,0.10", penwidth=1.2];
edge [color="#7C9BC5", penwidth=1.4, arrowsize=0.75, fontname="Segoe UI", fontsize=9, fontcolor="#C9D7EA"];

input [label="S3 raw data: daily gold + configured cross-asset prices; Yahoo news metadata\nIn cloud: SageMaker Processing; local mode only for developer tests",fillcolor="#164E63"];
schema [label="Schema / data quality contract\nRequired Date and gold_close; unique ascending dates\nfinite values, missingness, stale prices, duplicate rows, plausible ranges",fillcolor="#1D4ED8"];
market [label="Market feature construction\nLagged returns, lagged close, rolling mean/std/volatility\nAll rolling features use current/past observations only; no centered windows",fillcolor="#0F766E"];
news [label="News features (optional)\nPublished before cutoff only; title + summary lexicon score\nDaily/session aggregation and lagging; recent-feed coverage assessed",fillcolor="#6D28D9"];
target [label="Target definition\ny(t)=gold_close(t+1) ; baseline=gold_close(t)\nNo future target column in X; align X(t) only with information available at t",fillcolor="#7C2D12"];
audit [label="Leakage audit / quality gate\nDate ordering + duplicates + target excluded + nonfinite checks\nExact/near-perfect target correlation warnings + source-time lineage review\nFAIL => stop pipeline; no training / registration",fillcolor="#991B1B"];
split [label="Chronological partitions\nDefault: latest 20% final test; latest 10% of development for validation\nNo shuffle; train earlier than validation earlier than test",fillcolor="#1D4ED8"];
select [label="Feature selection / usefulness test\nTrain-only preprocessing; correlation and redundancy diagnostics\nMarket-only vs market+news ablation on identical folds",fillcolor="#5B21B6"];
out [label="Curated S3 outputs\nfeatures.parquet/CSV • split manifest • leakage_audit.json\nsource versions, code hash, row counts and time range",fillcolor="#14532D"];
input -> schema -> market; schema -> news; market -> target; news -> target; target -> audit -> split -> select -> out;
}