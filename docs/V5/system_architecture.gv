digraph G {
rankdir=TB;graph [bgcolor="#0B1220", pad="0.25", nodesep="0.28", ranksep="0.42", splines=ortho, fontname="Segoe UI", labeljust="c", labelloc="t"];
node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#49617F", fontcolor="#F5F7FB", margin="0.16,0.10", penwidth=1.2];
edge [color="#7C9BC5", penwidth=1.4, arrowsize=0.75, fontname="Segoe UI", fontsize=9, fontcolor="#C9D7EA"];

subgraph cluster_dev { label="DEVELOPMENT ONLY (optional local Windows)"; color="#64748B"; fontcolor="#CBD5E1"; style="rounded,dashed";
 dev [label="Developer workstation\n GUI / tests / AWS CLI SSO", fillcolor="#334155"];
}
subgraph cluster_cloud { label="AWS PRODUCTION EXECUTION"; color="#22D3EE"; fontcolor="#67E8F9"; style="rounded";
 schedule [label="Amazon EventBridge Scheduler\nDaily market/news ingestion trigger", fillcolor="#164E63"];
 lambda [label="Lambda A collector/orchestrator\nFetches Yahoo market/news metadata; logs run status", fillcolor="#155E75"];
 s3raw [label="Amazon S3 /raw/\nmarket_daily.csv + news.csv + ingestion logs\nversioning + encryption + lifecycle", fillcolor="#14532D"];
 process [label="SageMaker Processing Job\nLambda B schema normalization first; SageMaker Processing performs strict validation\nDuplicate removal • timestamp checks\nmissingness / finite values / coverage / leakage audit", fillcolor="#1D4ED8"];
 s3cur [label="Amazon S3 /curated/\nfeatures + split manifests + audit reports", fillcolor="#14532D"];
 pipe [label="SageMaker Pipelines\nProcessing → training → evaluation → conditional registration", fillcolor="#5B21B6"];
 train [label="SageMaker Training Jobs\nPersistence + ARIMA benchmark + tabular regressors\nWalk-forward CV / tuning on development data", fillcolor="#6D28D9"];
 exp [label="SageMaker Experiments\nparameters • code/data versions • fold metrics • artifacts", fillcolor="#5B21B6"];
 gate [label="Evaluation Quality Gate\nMAE / RMSE vs persistence • leakage PASS\ncoverage gate for news • minimum data quality", fillcolor="#92400E"];
 registry [label="SageMaker Model Registry\nVersioned model package: PendingManualApproval", fillcolor="#7C2D12"];
 human [label="Human review and approval\nInspect metrics, data lineage, model card and costs", fillcolor="#9F1239"];
 endpoint [label="SageMaker real-time endpoint\nApproved model only • request schema validation", fillcolor="#0F766E"];
 monitor [label="Model Monitor + CloudWatch\nInput drift • latency • 4xx/5xx • resource metrics\nDelayed-label error monitoring when actuals arrive", fillcolor="#334155"];
 retrain [label="EventBridge retraining trigger\nSchedule or sustained degradation alarm → pipeline run\nNew model remains unapproved until review", fillcolor="#7C3AED"];
}
dev -> pipe [style=dashed,label="authorized deployment / submit only"];
schedule -> lambda -> s3raw -> process -> s3cur -> pipe;
pipe -> train -> exp;
train -> gate; exp -> gate;
gate -> registry [label="pass"]; gate -> s3cur [label="fail: audit only", color="#F87171"];
registry -> human -> endpoint -> monitor -> retrain -> pipe;
}