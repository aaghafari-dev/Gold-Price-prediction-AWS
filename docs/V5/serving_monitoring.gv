digraph G {
rankdir=TB;graph [bgcolor="#0B1220", pad="0.25", nodesep="0.28", ranksep="0.42", splines=ortho, fontname="Segoe UI", labeljust="c", labelloc="t"];
node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#49617F", fontcolor="#F5F7FB", margin="0.16,0.10", penwidth=1.2];
edge [color="#7C9BC5", penwidth=1.4, arrowsize=0.75, fontname="Segoe UI", fontsize=9, fontcolor="#C9D7EA"];

client [label="Client / application\nHTTPS request with validated feature schema and forecast timestamp",fillcolor="#164E63"];
endpoint [label="SageMaker real-time endpoint\nApproved model artifact + inference.py\nInput schema / finite numeric values / feature order validated",fillcolor="#0F766E"];
predict [label="Prediction response\nnext-session gold-close estimate + model version + request ID\nNo unsupported confidence claim unless calibrated",fillcolor="#1D4ED8"];
logs [label="CloudWatch logs and metrics\nlatency, invocations, 4xx/5xx, throttles, endpoint health",fillcolor="#334155"];
monitor [label="SageMaker Model Monitor\nBaseline schema/statistics; capture inputs and outputs to S3\nScheduled data-quality and drift reports",fillcolor="#5B21B6"];
labels [label="Delayed actual market prices\nJoin forecast request ID / prediction date to realized next-session close",fillcolor="#92400E"];
perf [label="Performance monitoring\nRolling MAE / RMSE and directional accuracy after labels arrive\nCompare against persistence; distinguish drift from actual degradation",fillcolor="#7C2D12"];
alert [label="CloudWatch Alarm + EventBridge\nOperational alarm or sustained performance degradation triggers investigation / pipeline run\nNew version remains PendingManualApproval",fillcolor="#991B1B"];
client -> endpoint -> predict; endpoint -> logs; endpoint -> monitor; predict -> labels -> perf -> alert; monitor -> alert;
}