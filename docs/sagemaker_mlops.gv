digraph SageMakerMLOps {
  graph [label="AWS SageMaker MLOps — Training, Governance, Deployment", labelloc=t, fontsize=20, fontname="Arial", rankdir=LR, splines=ortho, nodesep=0.35, ranksep=0.6, pad=0.25, bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#486581", fillcolor="#F0F4F8", margin="0.14,0.09"];
  edge [fontname="Arial", fontsize=9, color="#627D98", arrowsize=0.75];
  sources [label="Yahoo Finance + GDELT"];
  ingest [label="Scheduled ingestion\n(local scheduler / EventBridge)"];
  s3raw [label="Amazon S3\nraw + processed data", fillcolor="#E3F2FD"];
  process [label="SageMaker Processing\nvalidation + feature creation"];
  train [label="SageMaker Training Job\nversioned code + parameters"];
  eval [label="Evaluation step\nwalk-forward metrics + baseline"];
  cond [shape=diamond, label="Quality gate passed?", fillcolor="#FFF3CD"];
  registry [label="SageMaker Model Registry\nversion + metrics + approval", fillcolor="#E8F5E9"];
  approval [label="Human approval"];
  deploy [label="Deploy approved model\nto SageMaker endpoint", fillcolor="#EDE7F6"];
  invoke [label="Client / FastAPI\nrequest schema validation"];
  monitor [label="CloudWatch + custom monitoring\nlatency • errors • drift • freshness"];
  retrain [label="Retraining trigger\nmanual or scheduled"];
  sources -> ingest -> s3raw -> process -> train -> eval -> cond;
  cond -> registry [label="yes"]; cond -> train [label="no", style=dashed];
  registry -> approval -> deploy -> invoke -> monitor;
  monitor -> retrain [style=dashed]; retrain -> ingest [style=dashed];
}