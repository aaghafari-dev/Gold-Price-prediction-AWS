digraph NewsPipeline {
  graph [label="News Pipeline — Ingestion to Leakage-Safe Daily Features", labelloc=t, fontsize=20, fontname="Arial", rankdir=TB, splines=ortho, nodesep=0.35, ranksep=0.45, pad=0.25, bgcolor="white"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#486581", fillcolor="#F0F4F8", margin="0.14,0.09"];
  edge [fontname="Arial", fontsize=9, color="#627D98", arrowsize=0.75];
  y [label="Yahoo Finance ticker news\nCurrent/available articles"];
  g [label="GDELT DOC API\nRecent public article search"];
  hist [label="Optional timestamped CSV\nFor reproducible historical tests"];
  norm [label="Normalize schema\npublished_at • retrieved_at • title • summary • source • URL", fillcolor="#E3F2FD"];
  dedup [label="Validate timestamps + deduplicate\nKeep source provenance"];
  cutoff [label="Point-in-time cutoff\nOnly articles known by prediction time", fillcolor="#FFF3CD"];
  text [label="Combine title + summary"];
  lex [label="Rule-based lexicon sentiment\nPositive/negative keyword counts"];
  agg [label="Aggregate by date\narticle count • mean/std sentiment\npositive/negative shares"];
  join [label="Join to market features\nusing explicit forecast calendar"];
  audit [label="Leakage + coverage audit\nmissing dates • future articles • source coverage", fillcolor="#E8F5E9"];
  out [label="Feature table for model training"];
  y -> norm; g -> norm; hist -> norm; norm -> dedup -> cutoff -> text -> lex -> agg -> join -> audit -> out;
}