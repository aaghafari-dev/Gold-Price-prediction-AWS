digraph ModelEval {graph [rankdir=TB,bgcolor="#0B1220",pad=.25,nodesep=.42,ranksep=.62,fontname=Arial,label="TRAINING & EVALUATION — CANDIDATES AND QUALITY GATE",labelloc=t,fontcolor=white,fontsize=18];node [shape=box,style="rounded,filled",fontname=Arial,fontsize=10,margin=".13,.09",color="#CBD5E1"];edge [color="#94A3B8",penwidth=1.4,arrowsize=.7];data [label="Curated S3 data\nwalk-forward folds\nfinal 20% holdout",fillcolor="#DBEAFE",fontcolor="#172554"];base [label="Baseline\npersistence: next close = current close",fillcolor="#FEF3C7",fontcolor="#78350F"];arima [label="Classical time-series benchmark\nARIMA/SARIMAX on ordered close series\nfit independently within each fold",fillcolor="#CCFBF1",fontcolor="#134E4A"];trees [label="Tabular ML candidates\nXGBoost · Random Forest\nExtra Trees · HistGradientBoosting\nlag/rolling features",fillcolor="#EDE9FE",fontcolor="#3B0764"];news [label="Optional news ablation\nmarket-only vs market+Yahoo features\nsame folds; coverage gate first",fillcolor="#FCE7F3",fontcolor="#831843"];metrics [label="Metrics report\nMAE + RMSE (lower is better)\ndirectional accuracy (separate metric)\nfold mean/std, rows and date ranges",fillcolor="#DBEAFE",fontcolor="#172554"];gate [label="Illustrative quality gate\nMAE ≥2% better than persistence\nfinite metrics + no leakage\nnews coverage ≥80% if news model",fillcolor="#FEF3C7",fontcolor="#78350F"];registry [label="Model Registry\nversioned package\nPendingManualApproval",fillcolor="#DDD6FE",fontcolor="#3B0764"];human [label="Human reviewer\ninspect reports + feature schema\napprove/reject with reason",fillcolor="#FDE68A",fontcolor="#78350F"];data->base;data->arima;data->trees;data->news;base->metrics;arima->metrics;trees->metrics;news->metrics;metrics->gate->registry->human;reject [label="Fail / reject\nretain current model; log reason",fillcolor="#FEE2E2",fontcolor="#7F1D1D"];gate->reject [label="gate fails",color="#F87171"]; }