digraph MLOps {
    graph [
        rankdir=TB,
        bgcolor="#0B1220",
        pad=.25,
        nodesep=.42,
        ranksep=.62,
        fontname=Arial,
        label="AWS SAGEMAKER MLOPS — MANAGED LIFECYCLE",
        labelloc=t,
        fontcolor=white,
        fontsize=18
    ];

    node [
        shape=box,
        style="rounded,filled",
        fontname=Arial,
        fontsize=10,
        margin=".13,.09",
        color="#CBD5E1"
    ];

    edge [
        color="#94A3B8",
        penwidth=1.4,
        arrowsize=.7
    ];

    event [
        label="EventBridge Scheduler\nfetch schedule / retraining triggers",
        fillcolor="#1D4ED8",
        fontcolor=white
    ];

    lambda [
        label="Lambda\nyfinance client\nmarket + Yahoo news",
        fillcolor="#1E40AF",
        fontcolor=white
    ];

    s3 [
        label="S3 raw / curated / artifacts\nKMS encryption + lifecycle",
        fillcolor="#DBEAFE",
        fontcolor="#172554"
    ];

    pipe [
        label="SageMaker Pipelines\nProcessing → Training → Evaluation",
        fillcolor="#6D28D9",
        fontcolor=white
    ];

    proc [
        label="SageMaker Processing\nquality checks / features / split",
        fillcolor="#0F766E",
        fontcolor=white
    ];

    train [
        label="SageMaker Training Jobs\nARIMA benchmark + tabular model jobs\nSageMaker Experiments tracks params/metrics",
        fillcolor="#5B21B6",
        fontcolor=white
    ];

    eval [
        label="Evaluation step\nMAE/RMSE/direction vs persistence\nquality and coverage gate",
        fillcolor="#FEF3C7",
        fontcolor="#78350F"
    ];

    reg [
        label="Model Registry\nversioned artifact + lineage\nPendingManualApproval",
        fillcolor="#DDD6FE",
        fontcolor="#3B0764"
    ];

    human [
        label="Human approval\nreview metrics, test dates, model card",
        fillcolor="#FDE68A",
        fontcolor="#78350F"
    ];

    endpoint [
        label="SageMaker Endpoint\nreal-time inference",
        fillcolor="#C2410C",
        fontcolor=white
    ];

    monitor [
        label="Model Monitor + CloudWatch\ninput drift, errors, p95 latency\nlabelled rolling MAE/RMSE",
        fillcolor="#FFEDD5",
        fontcolor="#7C2D12"
    ];

    event -> lambda -> s3 -> pipe -> proc -> train -> eval -> reg -> human -> endpoint -> monitor;

    monitor -> pipe [
        label="candidate retrain only",
        color="#FDBA74",
        fontcolor=white
    ];

    iam [
        label="IAM least privilege · CloudTrail · KMS · CloudWatch Logs · budget alarms",
        fillcolor="#334155",
        fontcolor=white
    ];

    iam -> lambda [style=dashed, arrowhead=none];
    iam -> train  [style=dashed, arrowhead=none];
    iam -> endpoint [style=dashed, arrowhead=none];
}