digraph GoldSystem { graph [rankdir=TB,bgcolor="#0B1220",pad="0.28",nodesep="0.35",ranksep="0.55",fontname="Arial",label="GOLD / USD FORECASTING — AWS SAGEMAKER END-TO-END TARGET",labelloc=t,fontcolor="#F8FAFC",fontsize=20]; node [shape=box,style="rounded,filled",fontname="Arial",fontsize=10,color="#CBD5E1",penwidth=1.3,margin="0.14,0.10"]; edge [color="#94A3B8",penwidth=1.5,arrowsize=.7,fontname="Arial",fontsize=8,fontcolor="#E2E8F0"];
subgraph cluster_ingest {label="01 · INGESTION (AWS)";color="#2563EB";fontcolor="#93C5FD";style="rounded"; sched [label="EventBridge Scheduler\nDaily schedule",fillcolor="#1D4ED8",fontcolor=white]; lambda [label="AWS Lambda\nPython + yfinance client\nprices + Yahoo ticker news",fillcolor="#1E40AF",fontcolor=white]; s3raw [label="Amazon S3 · raw/\nJSON/CSV snapshots + timestamps",fillcolor="#DBEAFE",fontcolor="#172554"]; sched->lambda->s3raw;}
subgraph cluster_prep {label="02 · DATA QUALITY & FEATURES (MANAGED)";color="#0D9488";fontcolor="#99F6E4";style="rounded"; proc [label="SageMaker Processing Job\nSchema / duplicates / finite values\nUTC timestamps / leakage audit",fillcolor="#0F766E",fontcolor=white]; curated [label="Amazon S3 · curated/\nchronological train/validation/test\nfeature schema + audit report",fillcolor="#CCFBF1",fontcolor="#134E4A"]; s3raw->proc->curated;}
subgraph cluster_ml {label="03 · EXPERIMENTS & GOVERNED MODEL BUILD";color="#7C3AED";fontcolor="#DDD6FE";style="rounded"; pipe [label="SageMaker Pipelines\nprocessing → train → evaluate",fillcolor="#6D28D9",fontcolor=white]; exp [label="SageMaker Training Jobs\nSageMaker Experiments\nARIMA + persistence + regressors",fillcolor="#5B21B6",fontcolor=white]; gate [label="Quality gate\nMAE / RMSE / direction\nvs persistence; coverage; no leakage",fillcolor="#EDE9FE",fontcolor="#3B0764"]; registry [label="SageMaker Model Registry\nVersioned package\nPendingManualApproval",fillcolor="#DDD6FE",fontcolor="#3B0764"]; human [label="Human approval\nReview metrics, dates, schema, cost",fillcolor="#FDE68A",fontcolor="#78350F"]; curated->pipe->exp->gate->registry->human;}
subgraph cluster_serve {label="04 · PRODUCTION INFERENCE & OPERATIONS";color="#EA580C";fontcolor="#FED7AA";style="rounded"; endpoint [label="SageMaker real-time Endpoint\napproved model version",fillcolor="#C2410C",fontcolor=white]; monitor [label="Model Monitor + CloudWatch\ndata drift / latency / errors\nrolling error after labels arrive",fillcolor="#FFEDD5",fontcolor="#7C2D12"]; retrain [label="EventBridge alarm/schedule\ntrigger candidate pipeline run\nnever auto-promote",fillcolor="#FED7AA",fontcolor="#7C2D12"]; human->endpoint->monitor->retrain;retrain->pipe [label="candidate retraining",color="#FDBA74"];}
security [label="Cross-cutting controls\nIAM least privilege · KMS encryption · CloudTrail · CloudWatch Logs · S3 lifecycle · cost alarms",fillcolor="#334155",fontcolor=white]; security->lambda [style=dashed,arrowhead=none];security->proc [style=dashed,arrowhead=none];security->endpoint [style=dashed,arrowhead=none];}