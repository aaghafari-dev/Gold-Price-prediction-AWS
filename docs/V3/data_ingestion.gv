digraph Ingestion {graph [rankdir=TB,bgcolor="#0B1220",pad=.25,nodesep=.48,ranksep=.68,fontname=Arial,label="DATA INGESTION — YAHOO FINANCE ONLY FOR NEWS",labelloc=t,fontcolor=white,fontsize=18];node [shape=box,style="rounded,filled",fontname=Arial,fontsize=10,margin=".14,.1",color="#CBD5E1"];edge [color="#94A3B8",penwidth=1.4,arrowsize=.7];sched [label="EventBridge Scheduler\nUTC schedule",fillcolor="#1D4ED8",fontcolor=white];lam [label="Lambda container/runtime\nPython yfinance client\nretry + timeout + run ID",fillcolor="#1E40AF",fontcolor=white];market [label="Market bars\nyfinance.download(symbol, interval='1d')\n",fillcolor="#DBEAFE",fontcolor="#172554"];news [label="Yahoo ticker news metadata\nyfinance.",fillcolor="#FCE7F3",fontcolor="#831843"];norm [label="Normalize schema\ntitle + summary as strings\n",fillcolor="#CCFBF1",fontcolor="#134E4A"];quality [label="Ingestion quality report\nrow counts · invalid timestamps\nduplicates · query time · API errors",fillcolor="#FEF3C7",fontcolor="#78350F"];s3 [label="S3 raw/\nversioned dated snapshots\nJSON/Parquet/CSV + manifest",fillcolor="#E0E7FF",fontcolor="#312E81"];sched->lam;lam->market;lam->news;market->norm;news->norm;norm->quality->s3; }