digraph Features {graph [rankdir=TB,bgcolor="#0B1220",pad=.25,nodesep=.42,ranksep=.62,fontname=Arial,label="FEATURE ENGINEERING, TARGET & LEAKAGE CONTROLS",labelloc=t,fontcolor=white,fontsize=18];node [shape=box,style="rounded,filled",fontname=Arial,fontsize=10,margin=".13,.09",color="#CBD5E1"];edge [color="#94A3B8",penwidth=1.4,arrowsize=.7];s3 [label="S3 raw snapshots\nmarket bars + Yahoo news",fillcolor="#DBEAFE",fontcolor="#172554"];proc [label="SageMaker Processing\nvalidate schema, unique dates, finite prices\nUTC timestamps, duplicates, missingness",fillcolor="#CCFBF1",fontcolor="#134E4A"];market [label="Market features (past only)\nlagged returns / price lags\nrolling volatility & momentum\noptional cross-asset lags",fillcolor="#EDE9FE",fontcolor="#3B0764"];news [label="News features\nonly published before cutoff\nsession aggregation + availability flag",fillcolor="#FCE7F3",fontcolor="#831843"];target [label="Target\nnext-session close or next-session return\nexplicit horizon = 1 market session",fillcolor="#FEF3C7",fontcolor="#78350F"];audit [label="Leakage audit\nfeatures must be available at cutoff\nfuture columns prohibited\nFAIL → stop pipeline; no training/register",fillcolor="#FEE2E2",fontcolor="#7F1D1D"];split [label="Chronological split\nfinal 20% untouched test\nwalk-forward folds within earlier 80%\nno shuffle",fillcolor="#D1FAE5",fontcolor="#065F46"];s3->proc;proc->market;proc->news;market->target;news->audit;market->audit;target->audit; audit->split; }