digraph GoldPriceSimpleE2E {
  graph [rankdir=TB, bgcolor="#F8FAFC", pad="0.35", nodesep="0.35", ranksep="0.55", splines=ortho, fontname="Arial", label="GOLD PRICE PREDICTION — SIMPLE END-TO-END ARCHITECTURE\nBuild and validate one vertical slice before adding advanced MLOps", labelloc=t, fontsize=20, fontcolor="#0F172A"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=11, color="#CBD5E1", penwidth=1.4, margin="0.18,0.12", fontcolor="#0F172A"];
  edge [fontname="Arial", fontsize=9, color="#64748B", penwidth=1.4, arrowsize=0.8];

  subgraph cluster_data {
    label="1. DATA — collect, validate, store"; labelloc=t; color="#93C5FD"; fillcolor="#EFF6FF"; style="rounded,filled"; fontname="Arial"; fontsize=13; fontcolor="#1D4ED8";
    source [label="Yahoo Finance market data\nGold futures (GC=F)\nDaily OHLCV", fillcolor="#DBEAFE"];
    landing [label="Raw data files\nCSV + retrieval timestamp\nLocal first; S3 in AWS", fillcolor="#DBEAFE"];
    quality [label="Data quality checks\nSchema • date order • duplicates\nmissing values • valid prices", fillcolor="#BFDBFE"];
    source -> landing -> quality;
  }
  subgraph cluster_analysis {
    label="2. ANALYSIS — understand the series"; labelloc=t; color="#6EE7B7"; fillcolor="#ECFDF5"; style="rounded,filled"; fontname="Arial"; fontsize=13; fontcolor="#047857";
    eda [label="Exploratory analysis\nPrice plot • returns • volatility\nmissingness and outliers", fillcolor="#D1FAE5"];
    features [label="Leakage-safe features\nLagged returns • rolling statistics\ncomputed using past data only", fillcolor="#A7F3D0"];
    target [label="Forecast target\nNext trading session close\nchronological timestamps", fillcolor="#D1FAE5"];
    quality -> eda -> features -> target;
  }
  subgraph cluster_model {
    label="3. MODEL — baseline before complexity"; labelloc=t; color="#C4B5FD"; fillcolor="#F5F3FF"; style="rounded,filled"; fontname="Arial"; fontsize=13; fontcolor="#6D28D9";
    split [label="Chronological split\nTrain 70% • validation 10%\nTest 20% (final period held out)", fillcolor="#EDE9FE"];
    baseline [label="Persistence baseline\nTomorrow's close = latest known close", fillcolor="#DDD6FE"];
    candidate [label="First candidate model\nRidge regression or Random Forest\nfit only on training data", fillcolor="#EDE9FE"];
    evaluate [label="Evaluate on validation / walk-forward\nMAE • RMSE • directional accuracy\ncompare with baseline", fillcolor="#DDD6FE"];
    gate [label="Decision gate\nIf candidate does not beat baseline:\nkeep baseline; investigate", fillcolor="#C4B5FD"];
    target -> split -> baseline;
    split -> candidate -> evaluate;
    baseline -> evaluate -> gate;
  }
  subgraph cluster_api {
    label="4. API — expose one prediction contract"; labelloc=t; color="#FDBA74"; fillcolor="#FFF7ED"; style="rounded,filled"; fontname="Arial"; fontsize=13; fontcolor="#C2410C";
    bundle [label="Saved inference bundle\nPreprocessing + selected model\nfeature names and version", fillcolor="#FFEDD5"];
    api [label="FastAPI prediction service\nPOST /predict • GET /health\ninput schema and validation", fillcolor="#FED7AA"];
    smoke [label="API smoke test\nknown input • response schema\nlatency and error handling", fillcolor="#FFEDD5"];
    gate -> bundle -> api -> smoke;
  }
  subgraph cluster_aws {
    label="5. AWS — move the same working slice to cloud"; labelloc=t; color="#FCD34D"; fillcolor="#FFFBEB"; style="rounded,filled"; fontname="Arial"; fontsize=13; fontcolor="#92400E";
    s3 [label="Amazon S3\nraw / processed data + model artifacts", fillcolor="#FEF3C7"];
    processing [label="SageMaker Processing\ndata checks + feature preparation", fillcolor="#FDE68A"];
    training [label="SageMaker Training Job\ntrain + evaluate; save artifacts", fillcolor="#FEF3C7"];
    endpoint [label="SageMaker real-time Endpoint\nserve predictions", fillcolor="#FDE68A"];
    logs [label="CloudWatch logs and metrics\nmanual review before further automation", fillcolor="#FEF3C7"];
    smoke -> s3 [label="upload same versioned inputs/artifacts"];
    s3 -> processing -> training -> endpoint -> logs;
  }

  note [shape=note, label="Scope discipline\nPhase 1: market data only; no news sentiment yet.\nDo not add Lambda, tuning, Registry automation, monitoring triggers, or Kubernetes\nuntil the basic data → analysis → model → API → AWS path works end-to-end.", fillcolor="#FFFFFF", color="#94A3B8", fontsize=10];
  logs -> note [style=dashed, arrowhead=none];
}
