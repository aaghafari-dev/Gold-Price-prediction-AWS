digraph Features {

    graph [rankdir=TB, bgcolor="#0A1220", pad="0.28", nodesep="0.34", ranksep="0.48", splines=ortho, fontname="Segoe UI", labeljust="l", labelloc="t", fontsize=20, fontcolor="#F5C451"];
    node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#536780", fontcolor="#F4F7FB", penwidth=1.35, margin="0.16,0.10"];
    edge [color="#9BB0CA", fontname="Segoe UI", fontsize=9, fontcolor="#D4DFEC", arrowsize=0.7, penwidth=1.2];

label="V4 | FEATURE ENGINEERING — LAGS, ROLLING WINDOWS, TARGET, BENCHMARKS AND INFORMATION TIMING";
market [label="Validated daily panel
Gold GC=F close; DXY, silver, oil, S&P 500, VIX, US 10Y yield, EURUSD, USDJPY
outer date join; context predictors forward-filled only", fillcolor="#164E63"];
price [label="Gold price history features
close lags: 1, 2, 3, 5, 10, 20 sessions
rolling mean: 5, 10, 20, 60; rolling return volatility: same windows
returns: 1 and 5 sessions; momentum: 20 sessions", fillcolor="#183A60"];
related [label="Related-market predictors
1-session percent returns for each available context close
Volume excluded from predictor list", fillcolor="#183A60"];
news [label="News daily aggregates
UTC publication-date group; mean/std score, counts, polarity shares, source count
Each news feature lagged by one market row", fillcolor="#5B4316"];
cutoff [label="Forecast-time convention
At row t, forecast next available market row close (default horizon=1)
Only lagged news is consumed; day-level UTC proxy is conservative
Not an exact futures exchange-close calendar", fillcolor="#5B4316"];
bench [label="Evaluation-only fields (never predictors)
Persistence: current gold close
5-session seasonal naive: gold close at t−4 for target t+1", fillcolor="#382957"];
target [label="Target + leakage checks
target_price = gold_close.shift(−horizon)
target_return = target_price / gold_close − 1
Date, current gold_close, targets, and benchmark columns excluded from X", fillcolor="#164A3A"];
clean [label="Training table
Drop initial rolling-window rows and rows without future target/benchmark
Numeric-only schema; stable feature manifest", fillcolor="#164A3A"];
market -> price; market -> related; market -> bench; market -> target; news -> cutoff; price -> target; related -> target; cutoff -> target -> clean; bench -> clean;
}
