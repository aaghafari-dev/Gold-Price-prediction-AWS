digraph GoldPricePredictionV9 {
  graph [rankdir=TB, bgcolor="#0b1220", pad="0.28", nodesep="0.42", ranksep="0.58", fontname="Arial", label="Gold Price Prediction V9 — Ironhack-aligned end-to-end architecture", labelloc=t, fontsize=22, fontcolor="#f5c451"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#45617e", fontcolor="#edf4ff", fillcolor="#17243a", margin="0.16,0.11"];
  edge [color="#8aa6c1", fontname="Arial", fontsize=9, fontcolor="#dbeafe", arrowsize=0.8];
  subgraph cluster_local { label="LOCAL DEVELOPMENT (Python 3.11 / Tkinter / VS Code)"; color="#47758d"; fontcolor="#8de6d1"; style="rounded";
    gui [label="Tkinter GUI\nWorkflow controls + result table\nprovider checkboxes + retries + RSS fallback + diagnostics"];
    yahoo [label="Yahoo Finance via yfinance\nGC=F + context tickers"];
    news [label="Optional news experiment\nGDELT and/or Yahoo ticker news\nindependent fetch + rate-aware retries + Yahoo RSS fallback + diagnostics"];
    prep [label="Validation + feature engineering\nChronological alignment + lagged features"];
    train [label="Nested walk-forward evaluation\nFeature selection inside training folds"];
    ablation [label="Matched-fold comparison\nMarket-only vs market + news"];
    prov [label="Run provenance\nInput snapshots, hashes, metrics, versions"];
    approval [label="Candidate gate + human approval\nPersistence / seasonal-naive baselines"];
    api [label="Local FastAPI\n/health, /ready, prediction ledger"];
    gui -> yahoo; gui -> news; yahoo -> prep; news -> prep; prep -> train; train -> ablation; ablation -> prov; prov -> approval; approval -> api;
  }
  subgraph cluster_aws { label="OPTIONAL AWS PHASE (resources are created only after deployment)"; color="#b38a34"; fontcolor="#f5c451"; style="rounded";
    schedule [label="EventBridge schedule\nweekday collector trigger", fillcolor="#3a2f1a", color="#b38a34"];
    lambda [label="AWS Lambda collector\nYahoo Finance recent snapshot", fillcolor="#3a2f1a", color="#b38a34"];
    s3 [label="Private, encrypted, versioned S3\nraw / processed / model artifacts", fillcolor="#3a2f1a", color="#b38a34"];
    smproc [label="SageMaker Processing\nfeature data checks / split", fillcolor="#3a2f1a", color="#b38a34"];
    smtrain [label="SageMaker Training\nmodel fit", fillcolor="#3a2f1a", color="#b38a34"];
    eval [label="SageMaker Evaluation + quality gate\ncompare with persistence", fillcolor="#3a2f1a", color="#b38a34"];
    registry [label="SageMaker Model Registry\nPendingManualApproval", fillcolor="#3a2f1a", color="#b38a34"];
    endpoint [label="SageMaker real-time endpoint\nmanual deploy after approval", fillcolor="#3a2f1a", color="#b38a34"];
    monitor [label="CloudWatch + Model Monitor\nlogs / errors / data quality", fillcolor="#3a2f1a", color="#b38a34"];
    schedule -> lambda -> s3 -> smproc -> smtrain -> eval -> registry -> endpoint -> monitor;
    monitor -> eval [style=dashed, label="review / retrain only after validation"];
  }
  prov -> s3 [style=dashed, label="upload selected snapshots / artifacts"];
  note [shape=note, fillcolor="#2a2330", color="#bb7b9e", fontcolor="#ffe4ef", label="Scope guardrails:\nGC=F is a Yahoo futures proxy, not an exchange-certified settlement feed.\nNews is optional and not assumed historically complete.\nAWS pipeline requires credentials, role setup, deployment, and cost monitoring."];
  approval -> note [style=dotted, arrowhead=none];
}
