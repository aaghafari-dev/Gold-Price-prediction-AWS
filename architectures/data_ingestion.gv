digraph DataIngestion {
    graph [rankdir=TB, bgcolor="#0A1220", pad="0.28", nodesep="0.38", ranksep="0.55", splines=ortho, fontname="Segoe UI", labeljust="l", labelloc="t", fontsize=20, fontcolor="#F5C451"];
    node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#536780", fontcolor="#F4F7FB", penwidth=1.35, margin="0.16,0.10"];
    edge [color="#9BB0CA", fontname="Segoe UI", fontsize=9, fontcolor="#D4DFEC", arrowsize=0.7, penwidth=1.2];
    label="V4 | DATA INGESTION — SOURCE ADAPTERS, PARAMETERS, NORMALIZATION AND ARCHIVE SEMANTICS";

    subgraph cluster_market {
        label="MARKET SERIES"; color="#2F8F83"; fontcolor="#71E2D0"; style="rounded";
        yfd [label="yfinance.download(symbol, daily interval, requested period default 10 years)\nGold GC=F is required; context symbols are predictors only", fillcolor="#164E63"];
        cache [label="data/raw/market_daily.csv\n24-hour local cache unless force-refresh\nDate normalized to UTC-naive day; gold rows retained", fillcolor="#164E63"];
        yfd -> cache;
    }
    subgraph cluster_news {
        label="NEWS SOURCE OPTIONS"; color="#3975B8"; fontcolor="#8DC4FF"; style="rounded";
        gdelt [label="GDELT DOC API v2\nGET api.gdeltproject.org/api/v2/doc/doc\nmode=ArtList, format=json, sort=DateDesc\ntimespan default 7d, default count=100, hard cap=250\nReturns article metadata and URL; no webpage scraping", fillcolor="#183A60"];
        yf [label="Yahoo ticker news\nyfinance.Ticker(symbol).get_news(count=100)\nFilter published_at within NEWS_LOOKBACK_DAYS (default 3 days)\nNot a general web search or historical archive", fillcolor="#183A60"];
        retry [label="GDELT retry policy\nHTTP/API attempts up to 3, backoff 1.5s × attempt\nTimeout 30s; reject non-JSON and HTTP failures", fillcolor="#183A60"];
    }
    norm [label="Canonical schema\npublished_at / retrieved_at UTC, title, summary, source, URL\nProvider response may omit summary; no full article body fetched", fillcolor="#5B4316"];
    dedup [label="Append + deduplicate\nkey = published_at + title + URL\nEmpty overwrite is rejected; records sorted by publication time", fillcolor="#5B4316"];
    snapshot [label="news_snapshots.jsonl\nAppend-only snapshot of metadata returned at each retrieval\nNot a full article-body archive", fillcolor="#183A60"];
    log [label="news_ingestion_log.csv\nProvider, query/ticker, requested timespan, query-window start/end, row counts\nA query window proves an attempt—not complete coverage", fillcolor="#3B2B50", color="#9D82C4"];
    gdelt -> retry -> norm;
    yf -> norm;
    norm -> dedup;
    dedup -> snapshot;
    dedup -> log;
}
