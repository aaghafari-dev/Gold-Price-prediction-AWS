digraph GoldPricePredictionV10 {
  graph [rankdir=TB, bgcolor="#0b1220", pad="0.28", nodesep="0.38", ranksep="0.52", fontname="Arial", label="Gold Price Prediction V11 — Ironhack end-to-end architecture", labelloc=t, fontsize=22, fontcolor="#f5c451"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#45617e", fontcolor="#edf4ff", fillcolor="#17243a", margin="0.16,0.11"];
  edge [color="#8aa6c1", fontname="Arial", fontsize=9, fontcolor="#dbeafe", arrowsize=0.8];
  subgraph cluster_local { label="LOCAL DEVELOPMENT / IRONHACK WORKFLOW"; color="#47758d"; fontcolor="#8de6d1"; style="rounded";
    gui [label="Tkinter GUI V10\nProvider selection + train/test fraction + metrics"];
    market [label="Yahoo Finance market bars\nGC=F daily proxy"];
    rss [label="Google News RSS\nKey-free headline search", fillcolor="#143a36", color="#3a9d87"];
    api_news [label="Optional NewsAPI / Alpha Vantage\nRequires user's API key"];
    legacy [label="Optional legacy GDELT / Yahoo news"];
    normalize [label="Normalize timestamps + deduplicate\nProvider status/error log; preserve old archive"];
    nlp [label="Pretrained ProsusAI/FinBERT\npositive / negative / neutral probabilities\nscore + confidence + magnitude"];
    features [label="Point-in-time alignment + features\nmarket lags + sentiment windows"];
    split [label="Chronological split\nDevelopment set + configurable final holdout"];
    cv [label="Walk-forward CV\ninner tuning + fold-local feature selection"];
    test [label="Untouched holdout metrics\nRMSE / MAE / direction vs persistence"];
    gate [label="Baseline gate + human approval"];
    serving [label="Local FastAPI"];
    live [label="Optional five-minute headline polling\nEWMA sentiment snapshots\nNOT a validated intraday price model", fillcolor="#3a2f1a", color="#b38a34"];
    gui -> market; gui -> rss; gui -> api_news; gui -> legacy;
    rss -> normalize; api_news -> normalize; legacy -> normalize; normalize -> nlp -> features; market -> features;
    features -> split -> cv -> test -> gate -> serving; gui -> live;
  }
  subgraph cluster_aws { label="OPTIONAL AWS PHASE (deploy separately; may incur charges)"; color="#b38a34"; fontcolor="#f5c451"; style="rounded";
    event [label="EventBridge schedule", fillcolor="#3a2f1a", color="#b38a34"];
    lambda [label="Lambda ingestion / validation", fillcolor="#3a2f1a", color="#b38a34"];
    s3 [label="Private S3 raw / processed / artifacts", fillcolor="#3a2f1a", color="#b38a34"];
    proc [label="SageMaker Processing + split", fillcolor="#3a2f1a", color="#b38a34"];
    train [label="SageMaker Training + evaluation", fillcolor="#3a2f1a", color="#b38a34"];
    registry [label="Model Registry\nPendingManualApproval", fillcolor="#3a2f1a", color="#b38a34"];
    endpoint [label="Endpoint after manual approval", fillcolor="#3a2f1a", color="#b38a34"];
    monitor [label="CloudWatch / Model Monitor", fillcolor="#3a2f1a", color="#b38a34"];
    event -> lambda -> s3 -> proc -> train -> registry -> endpoint -> monitor;
  }
  test -> s3 [style=dashed, label="reviewed artifacts"];
}
