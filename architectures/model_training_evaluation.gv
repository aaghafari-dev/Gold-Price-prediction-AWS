digraph Evaluation {

    graph [rankdir=TB, bgcolor="#0A1220", pad="0.28", nodesep="0.34", ranksep="0.48", splines=ortho, fontname="Segoe UI", labeljust="l", labelloc="t", fontsize=20, fontcolor="#F5C451"];
    node [shape=box, style="rounded,filled", fontname="Segoe UI", fontsize=10, color="#536780", fontcolor="#F4F7FB", penwidth=1.35, margin="0.16,0.10"];
    edge [color="#9BB0CA", fontname="Segoe UI", fontsize=9, fontcolor="#D4DFEC", arrowsize=0.7, penwidth=1.2];

label="V4 | MODEL TRAINING — CHRONOLOGICAL VALIDATION, BENCHMARKS, UNCERTAINTY AND SELECTION GATES";
data [label="Prepared numeric table
Rows in ascending Date order; horizon=1 session default
No random shuffling", fillcolor="#164E63"];
folds [label="Expanding walk-forward CV
sklearn TimeSeriesSplit(n_splits=5)
gap=max(1, target horizon); same folds for feature-set comparisons", fillcolor="#183A60"];
models [label="Candidate estimators
XGBoost: 500 trees, depth 4, lr 0.03, hist, n_jobs=2
Random Forest / Extra Trees: 500 trees, depth 12, leaf 2
HistGradientBoosting: max_iter 400, lr 0.04, 31 leaves", fillcolor="#5B4316"];
baselines [label="Benchmarks on identical held-out rows
Persistence: predict next close = current close
Seasonal naive: previous 5-session weekday close (close at t−4)
Candidate must beat both when seasonal benchmark is available", fillcolor="#5B4316"];
metrics [label="Metrics
Pooled RMSE + MAE; directional accuracy vs current close
Per-fold RMSE and train/test row counts
95% RMSE interval: 500 moving-block bootstrap samples (block length 5)
Optional 3-seed sensitivity + low/high volatility regime RMSE per fold", fillcolor="#5B4316"];
feature_sets [label="Feature-set ablation
Market-only always tested
Market + news only if query-window span ≥ 0.80 AND verified archive declared
--allow-unverified-news-experiment is exploratory and cannot promote news model", fillcolor="#382957"];
select [label="Selection / candidate gate
Lowest pooled RMSE among eligible models
Must beat persistence + seasonal naive and minimum improvement threshold
No eligible model → best=null with explicit reason", fillcolor="#164A3A"];
approval [label="Governance
Candidate manifest + joblib; separate human approval
No automatic champion overwrite; unverified news model blocked", fillcolor="#164A3A"];
audit [label="Artifacts
model_comparison.csv; training_result.json; timestamped audit JSON
Fold metrics, CI, source coverage flags, data hashes and package versions", fillcolor="#3B2B50", color="#9D82C4"];
data -> folds -> models -> metrics; data -> baselines -> metrics; feature_sets -> folds; metrics -> select -> approval; metrics -> audit; feature_sets -> audit;
}
